# universe.ai Environment Configuration
# Obtain your Gemini API key at: https://aistudio.google.com/app/apikey

# Required: Google Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Optional: Server Port (default: 3000)
PORT=3000

# Optional: Gemini Model Name (default: gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.8-flash
